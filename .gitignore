*.kubeconfig
kubectl-*.yaml
kubectl-*.yml

# Editor and operating-system artifacts
.DS_Store
Thumbs.db


# Archived legacy manifests — local only
archive-local/

# Private project notes — do not publish
/docs/obsidian/

# Raw Trivy reports — review and publish only curated summaries
/reports/trivy/*.json
/reports/trivy/*.txt

# Local security reports — publish only reviewed summaries
/reports/
